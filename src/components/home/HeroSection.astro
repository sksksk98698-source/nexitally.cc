---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, ChartColumn, Shield, Zap, Sparkles } from "@lucide/astro";

const stats = [
  { label: "香港 IPLC 专线", value: "18 ms", delta: "99.9% 稳定", cycle: ["18 ms", "17 ms", "18 ms", "19 ms"] },
  { label: "日本 IEPL 专线", value: "32 ms", delta: "零晚高峰拥堵", cycle: ["32 ms", "31 ms", "32 ms", "33 ms"] },
  { label: "单节点带宽",    value: "2.5 Gbps", delta: "4K 极速秒开", cycle: ["2.5 Gbps", "2.4 Gbps", "2.5 Gbps", "2.6 Gbps"] },
  { label: "AI与流媒体解锁", value: "100%", delta: "多地原生住宅", cycle: ["100%", "99.9%", "100%", "100%"] },
];

const bars = [85, 92, 88, 95, 94, 98, 96];
const barCycles = JSON.stringify([
  [85, 92, 88, 95, 94, 98, 96],
  [88, 90, 92, 94, 96, 95, 98],
  [84, 91, 89, 93, 95, 97, 96],
  [86, 93, 90, 96, 95, 99, 97],
]);
---

<div class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-32 xl:px-0">
  <div class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16">
    <!-- Left: Text -->
    <div class="relative w-full md:max-w-[560px] md:w-1/2 text-center sm:text-left sm:-mt-8">
      <!-- Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Badge variant="primary">始于 2020 稳定运营</Badge>
        <Badge variant="accent">全 IEPL / IPLC 专线</Badge>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border border-dashed border-primary/30 text-primary">
          VLESS 极速协议
        </span>
      </div>

      <!-- Title -->
      <h1 class="mb-4 text-3xl sm:text-4xl lg:text-5xl font-brand font-bold tracking-tight text-neutral-900 dark:text-white leading-tight">
        Nexitally 品牌官方官网<br />
        <span class="text-primary dark:text-primary-light">企业级全内网 IEPL / IPLC 专线</span>
      </h1>

      <!-- Subtitle -->
      <div class="mb-6">
        <p class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed font-normal">
          专注于<strong>高要求跨境电商出海、TikTok 直播推流、ChatGPT / Claude AI 生产力与全球 4K 超高清流媒体</strong>。全节点标配 ×1.0 真实倍率，单节点最高 2.5Gbps 带宽，不限设备数量，晚高峰稳定不卡顿。
        </p>
      </div>

      <!-- Feature Tags -->
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-neutral-500 dark:text-neutral-400 mb-8 justify-center sm:justify-start">
        <span class="flex items-center gap-1">
          <Zap class="w-3.5 h-3.5 text-primary" /> 自研客户端一键即连
        </span>
        <span class="flex items-center gap-1">
          <Shield class="w-3.5 h-3.5 text-emerald-500" /> Clash / 小火箭多端订阅
        </span>
        <span class="flex items-center gap-1">
          <Sparkles class="w-3.5 h-3.5 text-amber-500" /> 年付折算仅约 8.25元/月
        </span>
      </div>

      <!-- Buttons -->
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="600"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button url={siteConfig.registerUrl} target="_blank" type="fill" className="text-base px-6 py-3">
          立即开通 / 注册 <ArrowRight size={16} />
        </Button>
        <Button url="#pricing" className="text-base px-6 py-3">
          查看套餐方案
        </Button>
      </div>
    </div>

    <!-- Right: Product Preview (Dashboard mock) -->
    <div
      class="relative justify-end w-full mt-16 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      data-aos="fade-left-sm"
      data-aos-delay="300"
      data-aos-duration="800"
      data-aos-once="true"
    >
      <BrowserFrame url="nexitally.cc" className="w-full">
        <div class="p-5 md:p-6 h-[320px] md:h-[360px] flex flex-col gap-4">
          <!-- Mock toolbar -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="hero-live-dot relative w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-200">Nexitally Node Monitor (Live)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono">
                IEPL Connected
              </span>
            </div>
          </div>

          <!-- 2x2 Stat grid -->
          <div class="grid grid-cols-2 gap-3 flex-1">
            {stats.map((stat, i) => (
              <div class="rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 p-3 flex flex-col justify-between">
                <span class="text-[10px] font-medium text-neutral-500 dark:text-neutral-400">{stat.label}</span>
                <div class="flex items-end justify-between mt-1">
                  <span
                    class="hero-stat-value text-base md:text-lg font-brand text-neutral-800 dark:text-neutral-100 font-bold leading-none"
                    data-cycle={stat.cycle.join("|")}
                    style={`animation-delay: ${i * 400}ms;`}
                  >{stat.value}</span>
                  <span
                    class="hero-delta text-[10px] font-medium text-emerald-600 dark:text-emerald-400"
                    style={`animation-delay: ${i * 600}ms;`}
                  >{stat.delta}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Mini chart -->
          <div class="rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 p-3">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5">
                <ChartColumn class="w-3 h-3 text-primary" />
                <span class="text-[10px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400">专线晚高峰吞吐率 (99.9% SLA)</span>
              </div>
              <span class="text-[10px] text-emerald-500 font-mono">0.00% Packet Loss</span>
            </div>
            <div
              class="flex items-end gap-1.5 h-10 hero-bars"
              data-bar-cycles={barCycles}
            >
              {bars.map((h, i) => (
                <div
                  class:list={[
                    "hero-bar flex-1 rounded-sm origin-bottom",
                    i === bars.length - 1 ? "bg-primary hero-bar-active" : "bg-primary/35 dark:bg-primary/45",
                  ]}
                  style={`--bar-h: ${h}%; height: ${h}%; animation-delay: ${i * 90}ms;`}
                ></div>
              ))}
            </div>
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</div>

<style>
  /* ─── Live ping dot (toolbar) ─────────────────────── */
  .hero-live-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: currentColor;
    color: rgb(16, 185, 129);
    animation: hero-live-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes hero-live-ping {
    0%   { transform: scale(1);   opacity: 0.7; }
    80%, 100% { transform: scale(2.8); opacity: 0; }
  }

  /* ─── Toolbar progress micro-bar ──────────────────── */
  .hero-toolbar-progress {
    animation: hero-progress 3.6s ease-in-out infinite alternate;
  }
  @keyframes hero-progress {
    0%   { width: 1.5rem; opacity: 0.5; }
    50%  { width: 3.25rem; opacity: 0.85; }
    100% { width: 2rem; opacity: 0.6; }
  }

  /* ─── Stat numbers — subtle breath on cycle ────────── */
  .hero-stat-value {
    display: inline-block;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .hero-stat-value.is-cycling {
    transform: translateY(-2px);
    opacity: 0.65;
  }

  /* ─── Stat deltas — pulse opacity ──────────────────── */
  .hero-delta {
    animation: hero-delta-pulse 3s ease-in-out infinite;
  }
  @keyframes hero-delta-pulse {
    0%, 100% { opacity: 0.8; }
    50%      { opacity: 1; transform: scale(1.04); }
  }

  /* ─── Mini chart bars — idle breath wave ───────────── */
  .hero-bar {
    transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero-bar-active {
    box-shadow: 0 0 10px rgba(45, 109, 195, 0.45);
    animation: hero-bar-glow 2.4s ease-in-out infinite alternate;
  }
  @keyframes hero-bar-glow {
    0%   { opacity: 0.85; box-shadow: 0 0 6px rgba(45, 109, 195, 0.3); }
    100% { opacity: 1;    box-shadow: 0 0 14px rgba(45, 109, 195, 0.6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-live-dot::before,
    .hero-toolbar-progress,
    .hero-delta,
    .hero-bar-active {
      animation: none !important;
    }
  }
</style>
