---
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig, pricingPlans } from "@/config/site";
import { Check, Sparkles, Zap, ShieldCheck, ArrowRight } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "官方授权透明套餐方案",
  description = "全线标配企业级 IEPL / IPLC 专线与 VLESS 协议。无论轻量轻办公还是高负荷跨境出海，皆有对应专属方案。",
  showHeader = true,
} = Astro.props;
---

<section id="pricing" class="pricing-section py-16 md:py-24">
  {showHeader && (
    <div class="site-container mb-12" data-aos="fade-up-xs" data-aos-once="true">
      <SectionHeader title={title} description={description} />
      <p class="text-center text-xs text-neutral-400 dark:text-neutral-500 mt-3">
        * 所有套餐均享不限设备同时在线 · 支持自研多端客户端与第三方客户端订阅一键导入
      </p>
    </div>
  )}

  <!-- Pricing Cards Grid -->
  <div class="site-container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {pricingPlans.map((plan, i) => (
        <div
          class={`relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${
            plan.popular
              ? 'border-primary shadow-lg ring-2 ring-primary/20 bg-bg-secondary dark:bg-bg-secondary-dark'
              : 'border-primary/10 dark:border-neutral-700 bg-bg-secondary/70 dark:bg-bg-secondary-dark/70'
          }`}
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          {plan.popular && (
            <div class="popular-badge absolute -top-3.5 left-1/2 -translate-x-1/2 z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-white bg-gradient-to-r from-primary to-accent shadow-md">
                <Sparkles class="w-3.5 h-3.5" />
                <span>旗舰热销</span>
              </span>
            </div>
          )}

          <div>
            <!-- Card Header -->
            <div class="mb-4">
              <span class={`inline-block px-2.5 py-0.5 rounded-md text-xs font-medium mb-2.5 ${
                plan.popular ? 'bg-primary/15 text-primary dark:bg-primary/25 dark:text-primary-light' : 'bg-neutral-200/60 dark:bg-neutral-700/60 text-neutral-600 dark:text-neutral-300'
              }`}>
                {plan.badge}
              </span>
              <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">{plan.name}</h3>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 min-h-[32px] leading-relaxed">
                {plan.periodNote}
              </p>
            </div>

            <!-- Price & Traffic Banner -->
            <div class="p-3.5 rounded-xl bg-bg-primary/60 dark:bg-neutral-800/60 border border-primary/10 dark:border-neutral-700 mb-5">
              <div class="flex items-baseline gap-1">
                <span class="text-xs font-medium text-neutral-500">¥</span>
                <span class="text-3xl font-brand font-bold text-neutral-900 dark:text-neutral-50">{plan.price}</span>
                <span class="text-xs text-neutral-400 ml-1">{plan.billingPeriod}</span>
              </div>
              <div class="mt-2 pt-2 border-t border-dashed border-neutral-200 dark:border-neutral-700/60 flex items-center justify-between text-xs">
                <span class="font-medium text-primary dark:text-primary-light flex items-center gap-1">
                  <Zap class="w-3 h-3" />
                  {plan.traffic}
                </span>
                <span class="text-neutral-400 text-[11px]">{plan.speed}</span>
              </div>
            </div>

            <!-- Feature List -->
            <ul class="space-y-2.5 mb-6 text-xs leading-relaxed">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <Check class={`w-4 h-4 shrink-0 mt-0.5 ${
                    feature.highlight ? 'text-primary dark:text-primary-light' : 'text-emerald-500'
                  }`} />
                  <span class={`${feature.highlight ? 'font-medium text-neutral-800 dark:text-neutral-200' : 'text-neutral-600 dark:text-neutral-400'}`}>
                    {feature.text}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <div class="pt-4 border-t border-dashed border-primary/10 dark:border-neutral-700">
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              type={plan.popular ? "fill" : "solid"}
              className="w-full justify-center text-sm"
            >
              <span>{plan.ctaText}</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </Button>
          </div>
        </div>
      ))}
    </div>

    <!-- Security & Guarantee Notice -->
    <div class="mt-12 p-5 rounded-2xl bg-bg-secondary/50 dark:bg-bg-secondary-dark/50 border border-dashed border-primary/15 dark:border-neutral-700 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <div class="flex items-center gap-3">
        <ShieldCheck class="w-5 h-5 text-emerald-500 shrink-0" />
        <span>
          <strong class="text-neutral-700 dark:text-neutral-200">官方正品保证：</strong> 本网站为 Nexitally 品牌官方授权站点。全部套餐直连官方核心计费与节点分发系统。
        </span>
      </div>
      <div class="flex items-center gap-4 shrink-0 text-[11px]">
        <span>⚡ 99.9% 线路 SLA</span>
        <span>🛡️ VLESS 协议无日志加密</span>
        <span>🔄 节点故障自动秒级切换</span>
      </div>
    </div>
  </div>
</section>
