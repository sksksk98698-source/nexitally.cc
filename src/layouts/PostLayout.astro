---
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string | undefined;
  keywords?: string | undefined;
  description?: string | undefined;
  articleSchema?: {
    publishDate?: Date | string;
    modifiedDate?: Date | string;
    tags?: string[];
  };
}

const { title, description, keywords, articleSchema } = Astro.props;
---

<Layout title={title} description={description} keywords={keywords} articleSchema={articleSchema}>
  <main class="post-wrapper">
    <slot />
  </main>
</Layout>
