---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import { getCollection, render } from "astro:content";
import Badge from "@/components/ui/Badge.astro";
import { siteConfig } from "@/config/site";

const allEntries = await getCollection("changelog");
const entries = allEntries.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title={`节点动态与升级公告 — ${siteConfig.title} 品牌官方官网`}
  description="实时跟进 Nexitally 全球 IEPL/IPLC 专线扩容、节点健康状态、VLESS 协议升级与客户端版本发布动态。"
>
  <section class="site-container my-12">
    <PageHeader
      title="网络节点升级与维护公告"
      description="实时公布全球专线扩容、原生落地增补、客户端更新与日常网络优化记录。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <div class="relative">
      <div class="absolute left-4 md:left-6 top-0 bottom-0 w-px bg-neutral-200 dark:bg-neutral-700"></div>

      <div class="space-y-12">
        {entries.map(async (entry, i) => {
          const { Content } = await render(entry);
          return (
            <div
              class="relative pl-12 md:pl-16"
              data-aos="fade-up-sm"
              data-aos-delay={i * 80}
              data-aos-once="true"
            >
              <div class="absolute left-2.5 md:left-4.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>

              <div class="mb-2 flex items-center gap-3 flex-wrap">
                {entry.data.version && (
                  <Badge variant="primary" size="sm">{entry.data.version}</Badge>
                )}
                <time class="text-sm text-neutral-400 dark:text-neutral-500">
                  {formatDate(entry.data.publishDate)}
                </time>
              </div>

              <h2 class="text-xl md:text-2xl font-brand font-semibold text-neutral-800 dark:text-neutral-100 mb-2">
                {entry.data.title}
              </h2>

              {entry.data.description && (
                <p class="text-neutral-500 dark:text-neutral-400 text-sm mb-4 leading-relaxed">
                  {entry.data.description}
                </p>
              )}

              <div class="prose prose-neutral dark:prose-invert max-w-none text-sm leading-relaxed border-t border-dashed border-neutral-200 dark:border-neutral-700/60 pt-4">
                <Content />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
