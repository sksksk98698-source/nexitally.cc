---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Users, ShieldCheck, Zap, Globe } from "@lucide/astro";

const timeline = [
  {
    version: "2020 年",
    date: "品牌创立与专线基石",
    title: "开创全内网直连体验",
    desc: "Nexitally 正式创立并投入运营，确立以企业级 IEPL / IPLC 专线为核心的技术路线，杜绝公网波动，成为早期专注稳定品质的综合型标杆。",
  },
  {
    version: "2022 年",
    date: "原生落地与流媒体全解",
    title: "多大区原生住宅 IP 部署",
    desc: "完成香港、台湾、日本、美国、新加坡等多地优质原生落地部署，全面攻克 Netflix、Disney+ 4K 原生解锁与跨境电商防风控难题。",
  },
  {
    version: "2024 年",
    date: "协议重构与自研客户端",
    title: "全面拥抱 VLESS 与自研生态",
    desc: "全节点平滑迁移至更轻量更高效的 VLESS 原生协议，并同步发布 Windows、macOS、iOS、Android 跨平台自研一键客户端，极大降低使用门槛。",
  },
  {
    version: "2026 年",
    date: "极速演进与斯诺克 147",
    title: "2.5Gbps 单节点带宽与永久版",
    desc: "骨干节点全面扩容至单节点最高 2.5Gbps，晚高峰稳如泰山。正式发布致敬斯诺克 147 永久版套餐与灵活企业定制版方案。",
  },
];
---

<Layout
  title={`关于品牌 — ${siteConfig.title} 官方授权品牌官网`}
  description="了解 Nexitally（奶昔）自 2020 年以来的专线发展历程、企业内网服务理念与技术追求。"
>
  <section class="site-container my-12">
    <PageHeader
      title="始于 2020 年的品质坚守"
      description="不追求虚假低价与暴利超卖，我们用全内网专线与真实倍率，为用户提供长达数年始终如一的稳定连接。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-12">

      <!-- 品牌故事 -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-4">关于 Nexitally（奶昔）</h2>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed text-sm md:text-base">
          <p>
            在跨境出海、学术科研与远程办公领域，网络服务的核心价值永远只有两个字：<strong>稳定</strong>。许多用户经历过无数频繁换网址、晚高峰卡成幻灯片、甚至运营几个月就失联跑路的低质公网中转。
          </p>
          <p>
            <strong>Nexitally 创立于 2020 年</strong>，从第一天起就确立了“重线路质量、重真实倍率、重长期口碑”的发展方针。我们投资的是昂贵但极具可用性保障的企业级 IEPL / IPLC 专线物理信道，并将全量节点倍率统一规范为真实 1.0x。
          </p>
          <p>
            历经多年硬件与网络技术升级，Nexitally 已发展成为覆盖全球十余个主流国家和地区、单节点带宽最高达 2.5Gbps 的成熟综合型专线品牌，为数以万计的个人专业创作者、跨境出海机构及企业团队提供稳定保障。
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- 核心价值观 -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-6">我们的服务准则</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Globe class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">真专线，不超卖</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">坚持使用真实内网物理专线，杜绝劣质公网混充专线，确保晚高峰不拥塞。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Zap class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">现代 VLESS 架构</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">紧跟现代网络协议发展，降低握手消耗，提升单流并发与长连接吞吐。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Users class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">不限设备并发</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">所有套餐无设备连接数量限制，方便多手机、电脑及平板协同在线。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <ShieldCheck class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">7×24 持续守护</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">自动化链路监控巡检，突发物理故障秒级切换备用海缆，保障业务连续性。</p>
          </div>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- 品牌发展历程 -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-6">品牌演进历程</h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-1.5 bottom-1.5 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3 flex-wrap">
                  <Badge variant="primary" size="sm">{item.version}</Badge>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">{item.date}</span>
                </div>
                <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- 开启体验 CTA -->
      <div class="text-center pt-4" data-aos="fade-up-xs" data-aos-once="true">
        <h3 class="text-xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-3">开启 Nexitally 专线之旅</h3>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-6 max-w-md mx-auto">
          我们为每位追求高品质网络体验的用户提供稳定、低延迟且安全的专线支撑。
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button url={siteConfig.registerUrl} target="_blank" type="fill">
            前往官方注册 <ArrowRight size={16} />
          </Button>
          <Button url="/#pricing">
            查看套餐方案
          </Button>
        </div>
      </div>
    </article>
  </section>
</Layout>
