---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Clock3, LifeBuoy, Mail, MessageSquare, Sparkles, ShieldCheck } from "@lucide/astro";



const channels = [
  {
    icon: LifeBuoy,
    label: "在线工单支持",
    text: "官方控制台 7×24 小时工单通道",
    href: siteConfig.registerUrl,
  },
  {
    icon: Mail,
    label: "官方支持邮箱",
    text: siteConfig.mail,
    href: `mailto:${siteConfig.mail}`,
  },
  {
    icon: MessageSquare,
    label: "官方 Twitter (X)",
    text: `@${siteConfig.social.twitterName}`,
    href: siteConfig.social.twitter,
  },
];

const expectations = [
  { icon: Clock3, title: "响应时效", desc: "正常工单与咨询通常在 1~2 小时内由值班工程师快速处理。" },
  { icon: ShieldCheck, title: "线路运维", desc: "核心骨干网络 7×24 小时自动化探针监控，节点波动实时切换。" },
  { icon: LifeBuoy, title: "一对一协助", desc: "企业定制版客户享有专属架构师与企业微信/Telegram 专项沟通群。" },
];
---

<Layout
  title={`联系我们与技术支持 — ${siteConfig.title} 品牌官方官网`}
  description="联系 Nexitally 官方客服团队。获取自研客户端配置指导、企业专线定制方案与售后技术支持。"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] lg:items-start">
      <!-- 左侧：渠道说明 -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
          <Sparkles size={14} />
          支持中心
        </p>
        <h1 class="max-w-xl font-brand text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-neutral-800 dark:text-neutral-100">
          随时为您提供专业支持与专线咨询
        </h1>
        <p class="mt-5 max-w-lg text-sm sm:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
          无论您在客户端下载、订阅导入、企业出海专线定制还是套餐选购方面有任何疑问，我们的团队将竭诚为您解答。
        </p>

        <div class="mt-10 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {channels.map(({ icon: Icon, label, text, href }, index) => (
            <a
              href={href}
              target={href.startsWith("http") ? "_blank" : "_self"}
              rel={href.startsWith("http") ? "nofollow noopener noreferrer" : undefined}
              class="group flex items-center gap-4 rounded-xl border border-neutral-200 bg-bg-secondary/75 p-4 transition-all hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-md dark:border-neutral-700 dark:bg-bg-secondary-dark/75"
              data-aos="fade-up-xs"
              data-aos-delay={`${index * 100}`}
              data-aos-once="true"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-primary shadow-sm ring-1 ring-neutral-200/70 dark:bg-neutral-900/60 dark:ring-neutral-700">
                <Icon size={18} />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-neutral-800 dark:text-neutral-100">{label}</span>
                <span class="mt-0.5 block truncate text-xs text-neutral-500 dark:text-neutral-400">{text}</span>
              </span>
              <ArrowRight class="ml-auto h-4 w-4 shrink-0 text-neutral-300 transition-all group-hover:translate-x-1 group-hover:text-primary dark:text-neutral-600" />
            </a>
          ))}
        </div>

        <div class="mt-8 border-y border-dashed border-neutral-200 py-6 dark:border-neutral-700" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
          <div class="grid gap-5">
            {expectations.map(({ icon: Icon, title, desc }) => (
              <div class="flex gap-3">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <Icon size={16} /> 
                </span>
                <div>
                  <h3 class="text-xs font-semibold text-neutral-800 dark:text-neutral-100">{title}</h3>
                  <p class="mt-1 text-xs leading-5 text-neutral-500 dark:text-neutral-400">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 右侧：在线留言与直通入口 -->
      <div class="mx-auto w-full max-w-xl lg:max-w-none" data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <div class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-7 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 sm:p-9">
          <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-2">
            推荐优先使用工单系统
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-6 leading-relaxed">
            登录官方控制台提交工单，系统会自动关联您的订阅状态与节点测速数据，运维工程师能第一时间定位并处理。
          </p>

          <div class="space-y-4 mb-6">
            <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-xs">
              <span class="font-bold text-neutral-800 dark:text-neutral-200 block mb-1">💡 快捷排错小贴士：</span>
              <ul class="space-y-1.5 text-neutral-600 dark:text-neutral-400">
                <li>• 订阅更新失败：请尝试在客户端中切换「强制更新」或更换本地 DNS 为 1.1.1.1 / 8.8.8.8。</li>
                <li>• 节点全部超时：请确认设备时间是否准确同步至当前北京时间（误差超过90秒可能导致握手失败）。</li>
                <li>• 跨境电商与定制：如需独享原生 IP，请直接提交工单预约一对一定制方案。</li>
              </ul>
            </div>
          </div>

          <Button
            url={siteConfig.registerUrl}
            target="_blank"
            type="fill"
            className="w-full justify-center text-sm py-3.5 shadow-md"
          >
            <span>进入官方控制台提交工单</span>
            <ArrowRight class="w-4 h-4 ml-1.5" />
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>
