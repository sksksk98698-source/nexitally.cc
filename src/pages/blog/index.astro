---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import { siteConfig } from "@/config/site";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

<Layout
  title={`技术知识库与客户端教程 — ${siteConfig.title} 品牌官方官网`}
  description="Nexitally 官方订阅配置手册、Clash/小火箭教程、IEPL/VLESS 技术解析与 AI 生产力出海指南。"
>
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="技术知识库与客户端教程"
      description="为您提供官方客户端一键连接指南、主流第三方订阅导入手册与高标准专线网络最佳实践。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-8">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
