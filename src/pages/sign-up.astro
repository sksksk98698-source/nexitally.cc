---
import { ArrowRight, CircleCheck, ShieldCheck, Zap, Sparkles, Globe } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title={`官方授权账号开通 — ${siteConfig.title} 品牌官网`}
  description="Nexitally 官方直属注册开通通道。享受专属推荐授权，10秒快速开通全球 IEPL / IPLC 专线网络。"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid min-h-[calc(100vh-18rem)] items-center gap-10 lg:grid-cols-[minmax(420px,1.1fr)_minmax(0,0.9fr)]">
      <!-- 注册引导卡片 -->
      <div
        class="mx-auto w-full max-w-lg lg:order-first"
        data-aos="fade-up-xs"
        data-aos-once="true"
      >
        <div class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-7 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 sm:p-9">
          <!-- 标签 -->
          <div class="mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-primary bg-primary/10 border border-primary/20">
              <Sparkles class="w-3.5 h-3.5" /> 官方授权注册通道
            </span>
            <h1 class="mt-4 font-brand text-3xl sm:text-4xl font-bold tracking-tight text-neutral-800 dark:text-neutral-100">
              开启 Nexitally 专线账号
            </h1>
            <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              直连官方核心结算与节点分发集群。已内置专属优惠邀请码授权，10秒完成极速开通。
            </p>
          </div>

          <!-- 专享特权清单 -->
          <div class="p-4 rounded-2xl bg-bg-primary/60 dark:bg-neutral-800/60 border border-primary/10 dark:border-neutral-700 mb-6 space-y-2.5 text-xs text-neutral-600 dark:text-neutral-300">
            <div class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-emerald-500 shrink-0" />
              <span><strong>全链路 IEPL / IPLC 专线：</strong> 晚高峰 0% 拥塞丢包保障</span>
            </div>
            <div class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-emerald-500 shrink-0" />
              <span><strong>多端并发不限设备：</strong> 手机、电脑、平板全平台支持</span>
            </div>
            <div class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-emerald-500 shrink-0" />
              <span><strong>自研客户端 + 通用订阅：</strong> Clash / Shadowrocket 一键导入</span>
            </div>
            <div class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-emerald-500 shrink-0" />
              <span><strong>AI 与 4K 流媒体：</strong> ChatGPT 4o / Claude / Netflix 全解锁</span>
            </div>
          </div>

          <!-- 核心转化按钮 -->
          <div class="space-y-4">
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              type="fill"
              className="w-full justify-center text-base py-3.5 shadow-lg"
            >
              <span>前往官方系统立即注册</span>
              <ArrowRight class="w-4 h-4 ml-1.5" />
            </Button>
            <p class="text-center text-[11px] text-neutral-400">
              * 点击直达官方统一开通网关，系统将自动绑定邀请码 <code>keqgvT5Y</code>
            </p>
          </div>

          <!-- 提示 -->
          <div class="mt-6 pt-5 border-t border-dashed border-neutral-200 dark:border-neutral-700/60 text-center text-xs text-neutral-500">
            已有账号？
            <a href={siteConfig.registerUrl} target="_blank" rel="nofollow noopener noreferrer" class="text-primary hover:underline font-medium ml-1">
              直接登录控制台 &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- 右侧：信誉与保障 -->
      <div
        class="hidden lg:block space-y-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-once="true"
      >
        <div class="max-w-md">
          <p class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
            <ShieldCheck class="w-3.5 h-3.5" /> 品牌官方信誉保障
          </p>
          <h2 class="font-brand text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-100">
            始于 2020 年，值得托付核心业务的专线品牌
          </h2>
          <p class="mt-4 text-sm leading-7 text-neutral-600 dark:text-neutral-300">
            无论是跨境电商独立站运营、TikTok 直播推流，还是日常学术检索与 4K 高清影音，Nexitally 为您提供 7×24 小时不间断的极速网络护航。
          </p>
        </div>

        <div class="grid gap-3 max-w-md">
          <div class="p-4 rounded-2xl bg-bg-secondary/70 dark:bg-bg-secondary-dark/70 border border-primary/10 flex items-start gap-3">
            <Zap class="w-5 h-5 text-primary shrink-0 mt-0.5" />
            <div>
              <h3 class="text-xs font-bold text-neutral-800 dark:text-neutral-100">单节点最高 2.5 Gbps 突发吞吐</h3>
              <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">大文件下载、超高清视频秒开无压力，全节点真实 1.0x 计费。</p>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-bg-secondary/70 dark:bg-bg-secondary-dark/70 border border-primary/10 flex items-start gap-3">
            <Globe class="w-5 h-5 text-primary shrink-0 mt-0.5" />
            <div>
              <h3 class="text-xs font-bold text-neutral-800 dark:text-neutral-100">全球十余国核心专线节点</h3>
              <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">港/台/日/新/美/英/法/德/马/越/土/泰等全量专线持续扩容。</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
