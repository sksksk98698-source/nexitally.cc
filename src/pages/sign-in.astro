---
import { ArrowRight, CircleCheck, Lock } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title={`用户登录 / 订阅管理 — ${siteConfig.title} 品牌官网`}
  description="登录 Nexitally 官方用户中心。获取专属 VLESS 订阅链接、下载自研客户端并查看套餐流量配额。"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid min-h-[calc(100vh-18rem)] items-center gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(420px,1.05fr)]">
      <!-- 左侧介绍 -->
      <div
        class="hidden lg:block space-y-6"
        data-aos="fade-up-xs"
        data-aos-once="true"
      >
        <div class="max-w-md">
          <p class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
            <Lock size={13} /> 客户服务与控制台
          </p>
          <h1 class="font-brand text-4xl font-bold tracking-tight text-neutral-800 dark:text-neutral-100">
            欢迎回到 Nexitally 专线控制中心
          </h1>
          <p class="mt-4 text-sm leading-7 text-neutral-600 dark:text-neutral-300">
            在官方控制台轻松管理您的专线订阅、实时查看节点健康状态、一键下载多平台客户端，并享受 7×24 小时技术保障。
          </p>
        </div>

        <div class="space-y-3 max-w-md text-xs text-neutral-600 dark:text-neutral-400">
          <div class="flex items-center gap-2">
            <CircleCheck class="w-4 h-4 text-emerald-500" />
            <span>实时流量使用明细与到期时间查询</span>
          </div>
          <div class="flex items-center gap-2">
            <CircleCheck class="w-4 h-4 text-emerald-500" />
            <span>自研客户端一键扫码快捷授权接入</span>
          </div>
          <div class="flex items-center gap-2">
            <CircleCheck class="w-4 h-4 text-emerald-500" />
            <span>Clash / Shadowrocket / Surge 订阅地址复制与重置</span>
          </div>
        </div>
      </div>

      <!-- 右侧登录卡片 -->
      <div
        class="mx-auto w-full max-w-md"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-once="true"
      >
        <div class="rounded-3xl border border-primary/20 bg-bg-secondary/90 p-7 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 sm:p-9 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary/10 border border-primary/20 mb-4">
            <img src="/assets/logo.png" alt={siteConfig.title} class="w-10 h-10 rounded-full" />
          </div>
          <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-2">
            登录 Nexitally 官方控制台
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-6">
            本站为 Nexitally 官方授权站点，点击下方按钮直达统一客户控制台。
          </p>

          <Button
            url={siteConfig.registerUrl}
            target="_blank"
            type="fill"
            className="w-full justify-center text-base py-3.5 shadow-lg"
          >
            <span>进入官方控制台</span>
            <ArrowRight class="w-4 h-4 ml-1.5" />
          </Button>

          <div class="mt-6 pt-5 border-t border-dashed border-neutral-200 dark:border-neutral-700/60 text-xs text-neutral-500">
            还没有账号？
            <a href={siteConfig.registerUrl} target="_blank" rel="nofollow noopener noreferrer" class="text-primary hover:underline font-medium ml-1">
              立即开通新用户 &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
