---
import PageLayout from "@/layouts/PageLayout.astro";
import Button from "@/components/ui/Button.astro";
import { ArrowLeft, Mail, ShieldAlert } from "@lucide/astro";
import { siteConfig } from "@/config/site";
---

<PageLayout
  title={`404 页面未找到 — ${siteConfig.title} 品牌官方官网`}
  description="您访问的页面不存在或已被移除。"
  noindex={true}
  canonical={false}
>
  <section class="site-container py-14 md:py-24">
    <div class="grid min-h-[62vh] items-center gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(420px,1fr)]">
      <div data-aos="fade-up-xs" data-aos-once="true">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary dark:border-primary-light/20 dark:bg-primary-light/10 dark:text-primary-light">
          <ShieldAlert size={14} />
          Error 404
        </p>

        <h1 class="max-w-2xl font-brand text-4xl sm:text-5xl font-bold leading-tight tracking-tight text-neutral-800 dark:text-neutral-100">
          抱歉，您访问的页面不存在
        </h1>

        <p class="mt-5 max-w-xl text-sm sm:text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
          该页面可能已迁移、链接输入有误或正在维护中。建议您返回官网首页浏览套餐与最新配置教程。
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <Button url="/" type="fill">
            <ArrowLeft size={16} /> 返回官网首页
          </Button>
          <Button url={`mailto:${siteConfig.mail}?subject=404%20Broken%20link%20report`}>
            <Mail size={16} /> 反馈错误链接
          </Button>
        </div>
      </div>

      <div
        class="relative mx-auto w-full max-w-lg"
        data-aos="fade-up-xs"
        data-aos-delay="120"
        data-aos-once="true"
      >
        <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-bg-secondary/80 p-5 shadow-lg backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/80 sm:p-6">
          <div class="mb-5 flex items-center justify-between gap-4 border-b border-dashed border-neutral-200 pb-4 dark:border-neutral-700">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-red-400"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
              <span class="h-3 w-3 rounded-full bg-green-400"></span>
            </div>
            <span class="text-xs font-mono text-neutral-400">HTTP Status: 404 Not Found</span>
          </div>

          <div class="space-y-3 font-mono text-xs text-neutral-500 dark:text-neutral-400">
            <div>&gt; HOST: nexitally.cc</div>
            <div>&gt; ERROR: Route not registered in sitemap</div>
            <div class="text-primary">&gt; ACTION: Redirecting to safe landing zone...</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
