---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import {
  Globe, Monitor, Smartphone, Laptop, Tv,
  Sparkles, ArrowRight, Server, CloudLightning, ShieldCheck
} from "@lucide/astro";

// 品牌核心优势数据
const brandAdvantages = [
  {
    icon: Globe,
    title: "企业级 IEPL / IPLC 专线",
    desc: "全链路不经国际公网骨干出口，数据走运营商内网物理光纤直达海外核心机房，晚高峰丢包率趋近于 0，彻底告别降速与转圈。",
    tag: "物理内网直连",
  },
  {
    icon: CloudLightning,
    title: "全新轻量 VLESS 原生协议",
    desc: "精简多余加密握手，吞吐效率相较传统协议提升 30% 以上。高并发多连接小数据包极速响应，抗封锁与抗网络抖动能力极强。",
    tag: "低握手开销",
  },
  {
    icon: Tv,
    title: "4K / 8K 原生流媒体全解锁",
    desc: "香港、日本、新加坡、美国等多地配备原生住宅 IP，解锁 Netflix、Disney+、YouTube Premium、TikTok 全区内容，单节点最高 2.5Gbps 带宽秒开。",
    tag: "4K极速秒开",
  },
  {
    icon: Sparkles,
    title: "海外 AI 工具与跨境出海专护",
    desc: "针对 ChatGPT、Claude、Midjourney、GitHub Copilot 与 TikTok 跨境电商直播推流做专属路由分流，IP 纯净度高，避免频繁人机验证与封号风控。",
    tag: "AI纯净落地",
  },
  {
    icon: Monitor,
    title: "官方自研客户端 + 全平台兼容",
    desc: "提供开箱即用的一键自研客户端，同时无缝支持 Clash Verge、Shadowrocket (小火箭)、Surge、Sing-box 等通用第三方客户端订阅导入。",
    tag: "多端生态支持",
  },
  {
    icon: ShieldCheck,
    title: "始于 2020 年稳定运营品牌",
    desc: "坚持长期主义与充足硬件线路冗余，拒绝低质廉价跑路套路。全节点标配 ×1.0 真实倍率不虚标，提供 7×24 小时自动化健康巡检。",
    tag: "老牌品质口碑",
  },
];

// 使用流程三步快速上手
const steps = [
  {
    step: "01",
    title: "注册官方账号",
    desc: "进入官方授权系统，输入邮箱即可秒级开通账号，选择契合您业务需求的专线套餐方案。",
    badge: "10秒即刻开通",
  },
  {
    step: "02",
    title: "获取客户端或订阅",
    desc: "在用户后台一键下载 Windows、macOS、Android、iOS 官方自研客户端，或复制专属 VLESS 订阅链接。",
    badge: "多端全量兼容",
  },
  {
    step: "03",
    title: "一键连接专线节点",
    desc: "智能测速优选香港、日本、新加坡等超低时延专线节点，即刻畅享 2.5Gbps 极速网络体验。",
    badge: "晚高峰极速无忧",
  },
];

// 支持的客户端生态
const clientList = [
  { name: "Windows", type: "自研客户端 / Clash Verge", icon: Laptop },
  { name: "macOS", type: "自研客户端 / Clash / Surge", icon: Monitor },
  { name: "iOS", type: "自研客户端 / Shadowrocket / Surge", icon: Smartphone },
  { name: "Android", type: "自研客户端 / Clash Meta", icon: Smartphone },
  { name: "Linux / 路由器", type: "Clash Core / ShellCrash", icon: Server },
  { name: "全平台订阅", type: "通用 VLESS / Sub 格式转换", icon: Globe },
];

// 核心 FAQ 数据
const faqItems = [
  {
    question: "Nexitally（奶昔）与其他普通机场有何核心区别？",
    answer: "Nexitally 始于 2020 年运营，核心定位是兼顾极致稳定性与线路品质的老牌综合型品牌。全线采用企业级 IEPL / IPLC 内网专线与 VLESS 原生协议，所有节点标配 1.0x 真实倍率，单节点带宽最高达 2.5Gbps。不仅提供开箱即用的跨平台自研客户端，还全面兼容 Clash、Shadowrocket 等主流第三方工具，确保晚高峰零拥塞、超低延迟与 4K 秒开。"
  },
  {
    question: "轻量版套餐的 8.25 元/月是如何计算的？",
    answer: "8.25 元/月属于「轻量版」年付套餐（99元/年）折算后的平均每月成本，并非按普通单月付费。该套餐提供每月 69GB 高速流量（每月自动刷新重置），原生稳定节点覆盖港/台/日/新/马/美/英/法/德等多国，适合日常办公、学术查阅、邮件往来与轻度流媒体，是极具性价比的入门之选。"
  },
  {
    question: "斯诺克 147 永久套餐是怎样的计费机制？",
    answer: "斯诺克 147 永久套餐为一次性买断制（147元），内置 247GB 永久高速流量，没有任何到期时间限制，流量永久有效。原生节点覆盖香港×20、台湾×5、日本×10、新加坡×10、美国×10 等全球优质落地，非常适合作为备用主力线路，或出差、轻度办公的长效保障。"
  },
  {
    question: "套餐有限制在线设备数或客户端数量吗？",
    answer: "Nexitally 全系套餐均不限制在线设备数量。无论您在手机、平板、笔记本还是台式机上同时使用，均无多端连接门槛，充分满足个人多设备及小型团队的日常协同办公需求。"
  },
  {
    question: "对 ChatGPT、Claude 等海外 AI 工具有专门优化吗？",
    answer: "是的。针对 OpenAI 与 Anthropic 严格的 IP 风险控制机制，Nexitally 精选了纯净的原生住宅与优质商业 ISP 落地节点，欺诈评分极低。在自研客户端及通用订阅分流中已内置专用路由规则，保障 AI 工具流畅生成、不掉线、防风控拦截。"
  },
  {
    question: "遇到网络问题或节点波动如何获取支持？",
    answer: "系统部署了 7×24 小时全天候自动化链路健康检测机制，一旦某条海缆或机房发生波动，智能调度系统会在秒级自动切换至备用线路。同时官方控制台提供工单通道与在线客服，竭诚为您解决任何配置疑问。"
  },
];
---

<Layout
  title={siteConfig.meta.title}
  description={siteConfig.meta.description}
  faqSchema={faqItems}
>

  <!-- 1. 品牌 Hero 区域 -->
  <HeroSection />

  <!-- 2. 品牌数据与信誉背书条 -->
  <section class="py-8 border-y border-dashed border-primary/15 dark:border-neutral-700 bg-bg-secondary/40 dark:bg-bg-secondary-dark/40 site-container">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 text-center">
      <div class="p-3">
        <span class="block text-2xl font-brand font-bold text-primary dark:text-primary-light">2020</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">持续稳定运营至今</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-brand font-bold text-primary dark:text-primary-light">IEPL / IPLC</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">物理级内网专线</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-brand font-bold text-primary dark:text-primary-light">VLESS</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">轻量极速现代协议</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-brand font-bold text-primary dark:text-primary-light">2.5 Gbps</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">单节点最高速率</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-brand font-bold text-primary dark:text-primary-light">不限设备</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">多端并发在线无忧</span>
      </div>
      <div class="p-3">
        <span class="block text-2xl font-brand font-bold text-primary dark:text-primary-light">7×24 h</span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 block">全天候自动化容灾</span>
      </div>
    </div>
  </section>

  <!-- 3. 卡片式套餐方案展示 -->
  <Pricing
    title="官方授权透明套餐方案"
    description="全线标配企业级 IEPL / IPLC 专线与 VLESS 协议。涵盖永久买断、高性价比轻量年付、旗舰爆款极速版以及企业定制专线。"
  />

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 4. 产品核心优势展示 -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <SectionHeader
      title="为什么选择 Nexitally 专线服务？"
      description="拒绝廉价公网套路与虚高倍率。我们专注于高要求业务的长时稳定运行与真实纯净体验。"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      {brandAdvantages.map((adv, i) => (
        <div
          class="group p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 hover:border-primary/40 hover:shadow-lg transition-all duration-300"
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-light flex items-center justify-center transition-transform group-hover:scale-110">
              <adv.icon class="w-5 h-5" />
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700">
              {adv.tag}
            </span>
          </div>
          <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">{adv.title}</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">{adv.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. 使用流程：三步极速上手 -->
  <section id="steps" class="py-16 md:py-24 site-container bg-bg-secondary/40 dark:bg-bg-secondary-dark/40 rounded-3xl border border-dashed border-primary/15 dark:border-neutral-700">
    <div class="max-w-4xl mx-auto px-4">
      <SectionHeader
        title="三步极速上手，开启高速体验"
        description="流程简单清晰，自研客户端一键安装即可使用，小白与高阶用户皆能从容上手。"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        {steps.map((st, i) => (
          <div
            class="relative flex flex-col p-6 rounded-2xl bg-bg-primary dark:bg-neutral-900 border border-primary/10 dark:border-neutral-700 shadow-sm"
            data-aos="fade-up-sm"
            data-aos-delay={i * 120}
            data-aos-once="true"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl font-brand font-bold text-primary/80 dark:text-primary-light">{st.step}</span>
              <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-primary/10 text-primary">{st.badge}</span>
            </div>
            <h3 class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-2">{st.title}</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed flex-1">{st.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <Button url={siteConfig.registerUrl} target="_blank" type="fill" className="mx-auto">
          立即开通账号 <ArrowRight size={16} />
        </Button>
      </div>
    </div>
  </section>

  <!-- 6. 客户端与生态支持 -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader
      title="全平台客户端与通用订阅生态"
      description="官方自研客户端覆盖四大主流终端，并保持对全行业第三方成熟订阅工具的完整支持。"
    />
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mt-10">
      {clientList.map((client, i) => (
        <div
          class="flex flex-col items-center p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 text-center hover:-translate-y-1 hover:shadow-md transition-all duration-300"
          data-aos="fade-up-sm"
          data-aos-delay={i * 60}
          data-aos-once="true"
        >
          <client.icon class="w-7 h-7 text-primary dark:text-primary-light mb-3" />
          <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">{client.name}</span>
          <span class="text-[11px] text-neutral-400 mt-1">{client.type}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 7. 常见答疑 FAQ -->
  <div id="faq">
    <FAQ
      title="常见疑问与解答 (FAQ)"
      description="为您解答关于专线节点、计费周期、设备支持以及售后保障的关切问题。"
      items={faqItems}
    />
  </div>

  <!-- 8. SEO 教程与知识库入口 -->
  <div class="py-12 md:py-20 bg-bg-secondary/30 dark:bg-bg-secondary-dark/30 border-t border-dashed border-primary/10 dark:border-neutral-700">
    <BlogSection
      title="专线技术与配置知识库"
      description="提供详细的客户端订阅配置手册、AI 生产力连接指南与企业专线架构解析。"
      limit={4}
    />
  </div>

  <!-- 9. 底部高转化注册 CTA -->
  <section class="py-16 md:py-20 site-container rounded-3xl bg-gradient-to-b from-bg-secondary to-bg-primary dark:from-bg-secondary-dark dark:to-neutral-900 border border-primary/15 my-12" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-3xl mx-auto text-center px-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-primary bg-primary/10 border border-primary/20 mb-4">
        <Sparkles class="w-3.5 h-3.5" /> 官方授权直属注册通道
      </span>
      <h2 class="text-3xl md:text-4xl font-brand font-bold text-neutral-900 dark:text-white mb-4">
        体验真正的企业级全内网低时延专线
      </h2>
      <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed max-w-xl mx-auto">
        告别晚高峰卡顿、低质广播 IP 与频繁掉线。加入 Nexitally，让跨境办公、AI 生产力与 4K 超高清视界更加从容。
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button url={siteConfig.registerUrl} target="_blank" type="fill" className="text-base px-8 py-3.5">
          立即开通账号 <ArrowRight size={18} />
        </Button>
        <Button url="#pricing" className="text-base px-8 py-3.5">
          查看套餐对比
        </Button>
      </div>
      <p class="text-[11px] text-neutral-400 mt-4">
        * 本站为 Nexitally 官方授权网站，点击立即安全跳转至统一开通系统
      </p>
    </div>
  </section>

</Layout>
